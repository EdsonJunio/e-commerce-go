#!/usr/bin/env bash
set -euo pipefail
PROJECT_NAME="ecommerce-api"
usage() {   echo "Uso: $0 [-p PROJECT_NAME] [-m MODULE_PATH] [-f]";   echo "  -p  Nome da pasta do projeto (default: ecommerce)";   echo "  -m  module do Go (default: github.com/yourname/ecommerce)";   echo "  -f  Sobrescreve arquivos existentes quando necessário";   exit 1; }
while getopts ":p:m:f" opt; do   case "$opt" in     p) PROJECT_NAME="$OPTARG" ;;     m) MODULE_PATH="$OPTARG" ;;     f) FORCE=1 ;;     *) usage ;;   esac; done
wfile() {   local path="$1";   local content="$2";   if [[ -f "$path" && "$FORCE" -ne 1 ]]; then     echo "skip: $path (existe; use -f para sobrescrever)";     return 0;   fi;   mkdir -p "$(dirname "$path")";   printf "%s" "$content" > "$path";   echo "write: $path"; }
