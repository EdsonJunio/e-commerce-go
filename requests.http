#########################################################
# Configuration
#########################################################
@baseUrl = http://localhost:8081/api/v1
@hostUrl = http://localhost:8081

# 1. Login (Execute this first to get the Token)
# If using VS Code REST Client, the token is saved automatically.
# If not, copy the token from the response and paste it into the @authToken variable below.
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "password": "hash123"
}

### Token Variable (Captured automatically or paste here)
@authToken = {{login.response.body.data.token}}

#########################################################
# Infra / Health
#########################################################

### Health check (Liveness)
GET {{hostUrl}}/live
Content-Type: application/json

### Ready check (Readiness - DB connection)
GET {{hostUrl}}/ready
Content-Type: application/json

#########################################################
# Product Endpoints
#########################################################

### List all products (Public)
# Optional query params: page, limit, category_id, is_active
GET {{baseUrl}}/products?page=1&limit=10
Content-Type: application/json

### Get product by ID
GET {{baseUrl}}/products/1
Content-Type: application/json

### Get product by slug
GET {{baseUrl}}/products/slug/iphone-15-pro
Content-Type: application/json

### Create a new product (Protected)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "category_id": 1,
  "name": "Sapato Nike Air",
  "slug": "sapato-nike-air-2025",
  "is_active": true,
  "seoTitle": "Sapato Nike Air Melhor Preco",
  "seoDescription": "O melhor sapato de corrida",
  "description": "Um produto excelente para atletas"
}

### Update a product (Protected)
PUT {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Sapato Nike Air PRO",
  "price_cents": 50000
}

### Delete a product (Protected)
DELETE {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

#########################################################
# Category Endpoints
#########################################################

### List all categories (Public)
GET {{baseUrl}}/categories?page=1&limit=10
Content-Type: application/json

### Get category by ID
GET {{baseUrl}}/categories/1
Content-Type: application/json

### Create a category (Protected)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Laptops",
  "slug": "laptops-and-notebooks",
  "description": "Laptop computers and accessories",
  "is_active": true,
  "parent_id": 1
}

### Update a category (Protected)
PUT {{baseUrl}}/categories/2
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Notebooks Gamer",
  "description": "High performance laptops"
}

### Delete a category (Protected)
DELETE {{baseUrl}}/categories/99
Content-Type: application/json
Authorization: Bearer {{authToken}}