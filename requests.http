#########################################################
# GLOBAL CONFIGURATION
#########################################################

@hostUrl = http://localhost:8081
@baseUrl = {{hostUrl}}/api/v1

#########################################################
# AUTHENTICATION
#########################################################

### Login (execute primeiro)
# O token será capturado automaticamente pelo REST Client
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "password": "hash123"
}

### Auth Token (auto ou manual)
@authToken = {{login.response.body.data.token}}

#########################################################
# INFRA / HEALTH CHECKS
#########################################################

### Liveness
GET {{hostUrl}}/live
Content-Type: application/json

### Readiness (DB, deps, etc)
GET {{hostUrl}}/ready
Content-Type: application/json

#########################################################
# PRODUCTS
#########################################################

### List products (Public)
# Query params: page, limit, category_id, is_active
GET {{baseUrl}}/products?page=1&limit=10
Content-Type: application/json

### Get product by ID
GET {{baseUrl}}/products/1
Content-Type: application/json

### Get product by Slug
GET {{baseUrl}}/products/slug/iphone-15-pro
Content-Type: application/json

### Create product (Protected)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "category_id": 1,
  "name": "Sapato Nike Air",
  "slug": "sapato-nike-air-2025",
  "is_active": true,
  "seoTitle": "Sapato Nike Air Melhor Preço",
  "seoDescription": "O melhor sapato de corrida",
  "description": "Um produto excelente para atletas"
}

### Update product (Protected)
PUT {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Sapato Nike Air PRO",
  "price_cents": 50000
}

### Delete product (Protected)
DELETE {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

#########################################################
# CATEGORIES
#########################################################

### List categories (Public)
GET {{baseUrl}}/categories?page=1&limit=10
Content-Type: application/json

### Get category by ID
GET {{baseUrl}}/categories/1
Content-Type: application/json

### Create category (Protected)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Laptops",
  "slug": "laptops-and-notebooks",
  "description": "Laptop computers and accessories",
  "is_active": true,
  "parent_id": 1
}

### Update category (Protected)
PUT {{baseUrl}}/categories/2
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Notebooks Gamer",
  "description": "High performance laptops"
}

### Delete category (Protected)
DELETE {{baseUrl}}/categories/99
Content-Type: application/json
Authorization: Bearer {{authToken}}

#########################################################
# SKUS
#########################################################

### List skus (Public)
GET {{baseUrl}}/skus
Content-Type: application/json





























