# Base URL
@baseUrl = http://localhost:8080/api/v1

#########################################################
# Product Endpoints (for reference)
#########################################################

### List all products (with pagination)
# Optional query params: page, limit, category_id, is_active
GET {{baseUrl}}/products?page=1&limit=10
Content-Type: application/json

### Get product by ID
GET {{baseUrl}}/products/21
Content-Type: application/json

### Get product by slug
GET {{baseUrl}}/products/slug/2
Content-Type: application/json

### Create a new product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "category_id": 1,
  "name": "Sapato",
  "slug": "moda22",
  "is_active": true,
  "seoTitle": "seoTitle",
  "seoDescription": "seoDescription",
  "description": "A great new product"


}

### Update a product (partial update)
PUT {{baseUrl}}/products/16
Content-Type: application/json

{
  "category_id": 1,
  "name": "Sapato",
  "slug": "6992",
  "is_active": true,
  "seoTitle": "seoTitle",
  "seoDescription": "seoDescription",
  "description": "A great new product"
}

### Delete a product
DELETE {{baseUrl}}/products/16
Content-Type: application/json

#########################################################
# Health Check
#########################################################

### Health check
GET {{baseUrl}}/health
Content-Type: application/json



#########################################################
# Category Endpoints
#########################################################

### List all categories (with pagination)
# Optional query params: page, limit, parent_id, is_active
GET {{baseUrl}}/categories?page=1&limit=10
Content-Type: application/json

### Get category by ID
GET {{baseUrl}}/categories/1
Content-Type: application/json

### Get category by slug
GET {{baseUrl}}/categories/slug/moda
Content-Type: application/json

### Create a sub-category (with parent)
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Laptops",
  "slug": "36",
  "description": "Laptop computers and accessories",
  "is_active": true,
  "parent_id": 1

}

### Update a category (partial update)
# Only include fields that need to be updated
PUT {{baseUrl}}/categories/0
Content-Type: application/json

{
  "name": "Laptops & Notebooks",
  "description": "Laptops, notebooks and accessories"
}

### Toggle category active status
PUT {{baseUrl}}/categories/
Content-Type: application/json

{
  "is_active": false
}

### Change category parent
PUT {{baseUrl}}/categories/
Content-Type: application/json

{
  "parent_id": 1
}

### Delete a category
DELETE {{baseUrl}}/categories/9
Content-Type: application/json

### Try to delete a category with subcategories (should fail)
DELETE {{baseUrl}}/categories/1
Content-Type: application/json
