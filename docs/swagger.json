        "internal_catalog_delivery_http.CreateCategoryRequest": {
            "type": "object",
            "required": [
                "name",
                "slug"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "All kinds of electronic devices"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "Electronics"
                },
                "parent_id": {
                    "type": "integer",
                    "example": 1
                },
                "slug": {
                    "type": "string",
                    "example": "electronics"
                }
            }
        },
        "internal_catalog_delivery_http.CreateProductRequest": {
            "type": "object",
            "required": [
                "category_id",
                "description",
                "is_active",
                "name",
                "seoDescription",
                "seoTitle",
                "slug"
            ],
            "properties": {
                "category_id": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                },
                "description": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "Titanium design, A17 Pro chip"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "iPhone 15 Pro"
                },
                "seoDescription": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "The new iPhone 15 Pro"
                },
                "seoTitle": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3,
                    "example": "iPhone 15 Pro - Apple"
                },
                "slug": {
                    "type": "string",
                    "example": "iphone-15-pro"
                }
            }
        },
