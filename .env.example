# Application Configuration
APP_NAME=e-commerce-go
APP_VERSION=dev
APP_ENVIRONMENT=development

# Server Configuration
SERVER_PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=5s
SERVER_MAX_BODY_BYTES=1048576
ENABLE_PPROF=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ecommerce
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CATEGORY_TTL=1m

# Authentication Configuration
# Generate a unique value with at least 32 characters before startup.
JWT_SECRET=
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-clients
JWT_ACCESS_TOKEN_TTL=15m
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=1m

# Development tools
GRAFANA_ADMIN_PASSWORD=
SEED_DATABASE_URL=
SEED_CONFIRM=truncate-ecommerce
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=12h
